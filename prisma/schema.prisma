// Buja Auto Spa ERP - Cloud Database Schema
// Central source of truth for synchronized business data
// Provider is SQLite for development, easily swappable to PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums - stored as String for SQLite compatibility (emulated enums)
// Values: UserStatus: ACTIVE, INACTIVE, SUSPENDED
// RoleName: SUPER_ADMIN, ADMIN, MANAGER, CASHIER, MECHANIC, WASHER, RENTAL_AGENT, ACCOUNTANT, VIEWER
// SyncStatus: SYNCED, PENDING, FAILED, CONFLICT
// SyncOperation: CREATE, UPDATE, DELETE

// Core User & Auth Models
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?
  status        String   @default("ACTIVE")
  
  // Sync metadata - required for offline-first
  version       Int      @default(1) // Optimistic locking version
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSyncedAt  DateTime?
  deviceId      String?  // Last device that modified
  isDeleted     Boolean  @default(false) // Soft delete for sync
  
  // Relations
  roles         UserRole[]
  sessions      Session[]
  syncLogs      SyncLog[]
  auditLogs     AuditLog[]
  
  @@index([email])
  @@index([username])
  @@index([status])
  @@index([updatedAt])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)
  
  permissions RolePermission[]
  users       UserRole[]
  
  @@index([name])
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "customers:read", "sales:create"
  module      String   // e.g. "customers", "sales", "settings"
  action      String   // read, create, update, delete, manage
  description String?
  
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  roles       RolePermission[]
  
  @@index([module])
  @@index([key])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  assignedAt DateTime @default(now())
  assignedBy String?  // userId who assigned
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String
  
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  deviceId     String?
  deviceInfo   String?  // JSON stringified
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  isRevoked    Boolean  @default(false)
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

// Synchronization & Offline-First Infrastructure
model SyncLog {
  id            String        @id @default(uuid())
  userId        String?
  deviceId      String
  entityType    String        // e.g. "User", "Customer", "Vehicle"
  entityId      String
  operation     String
  status        String        @default("PENDING")
  version       Int           // Entity version at sync time
  clientVersion Int?          // Version sent by client
  serverVersion Int?          // Current server version
  payload       String?       // JSON payload for debugging
  errorMessage  String?
  conflictData  String?       // JSON for conflict resolution
  retryCount    Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  syncedAt      DateTime?
  
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([deviceId])
  @@index([entityType, entityId])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model SyncMetadata {
  id            String   @id @default(uuid())
  deviceId      String   @unique
  userId        String?
  lastPullAt    DateTime?
  lastPushAt    DateTime?
  lastSyncAt    DateTime?
  clientVersion String?  // App version
  pendingCount  Int      @default(0)
  failedCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
  @@index([deviceId])
}

// Audit trail
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   // e.g. "user.login", "customer.create"
  entityType  String?
  entityId    String?
  oldData     String?  // JSON
  newData     String?  // JSON
  ipAddress   String?
  deviceId    String?
  createdAt   DateTime @default(now())
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// Placeholder for future business modules - foundation only
// These will be expanded in next phases but defined now for sync architecture

model SyncCheckpoint {
  id          String   @id @default(uuid())
  entityType  String   @unique // e.g. "customers", "vehicles"
  lastVersion Int      @default(0)
  lastId      String?
  updatedAt   DateTime @updatedAt
}
